# name: test/sql/ingest_multimodal.test
# description: Read back agent_runs output with the independent Lance test dependency
# group: [sql]

require agent_runs

query TTI
CALL ingest_agent_run('testdata/harbor/job',
    trajectory_destination := '{TEST_DIR}/datasets');
----
00000000-0000-0000-0000-000000000001	completed-job	1

# The two extensions register the same COPY format. Verify the written datasets
# in a fresh database with only the independent Lance reader loaded.
restart no_extension_load

require lance

query I
SELECT count(*) FROM '{TEST_DIR}/datasets/00000000-0000-0000-0000-000000000002.lance';
----
1

# Check the concrete metadata values from the ATIF fixture.
query TTTT
SELECT trajectory_id, atif_schema_version, agent.name, agent.version
FROM '{TEST_DIR}/datasets/00000000-0000-0000-0000-000000000002.lance';
----
media	ATIF-v1.8	test	1

# The original ATIF document is also preserved byte for byte.
query I
SELECT d.raw_json = expected.content
FROM '{TEST_DIR}/datasets/00000000-0000-0000-0000-000000000002.lance' d,
     read_text('testdata/harbor/job/task__abc/agent/trajectory.json') expected;
----
true

# Inspect every typed step, including its decoded Unicode text.
query ITT
SELECT step.step_id, step.source, decode(step.message[1].text)
FROM (SELECT unnest(steps) AS step FROM '{TEST_DIR}/datasets/00000000-0000-0000-0000-000000000002.lance')
ORDER BY step.step_id;
----
1	user	hello 你好🙂
2	agent	Inspecting the supplied media.
3	agent	The image is an RGB pattern; the audio is a short tone.

query T
SELECT decode(steps[2].observation.results[1].content[1].text)
FROM '{TEST_DIR}/datasets/00000000-0000-0000-0000-000000000002.lance';
----
RGB pattern and a 440 Hz tone.

query TTT
SELECT steps[2].tool_calls[1].tool_call_id,
       steps[2].tool_calls[1].function_name,
       steps[2].tool_calls[1].arguments_json
FROM '{TEST_DIR}/datasets/00000000-0000-0000-0000-000000000002.lance';
----
inspect-1	inspect_media	{}

# Compare embedded message/observation media bytes with the repository PNG/WAV files.
query IIII
SELECT d.steps[1].message[2].source.path = image.content,
       d.steps[1].message[3].source.path = audio.content,
       d.steps[2].observation.results[1].content[2].source.path = image.content,
       d.steps[2].observation.results[1].content[3].source.path = audio.content
FROM '{TEST_DIR}/datasets/00000000-0000-0000-0000-000000000002.lance' d,
     read_blob('testdata/harbor/job/task__abc/agent/atif-image.png') image,
     read_blob('testdata/harbor/job/task__abc/agent/atif-audio.wav') audio;
----
true	true	true	true
