# name: test/sql/schema_migration.test
# description: Check load-time schema initialization and version handling
# group: [sql]

require agent_runs

load {TEST_DIR}/catalog.db

query IIII
SELECT (SELECT max(version) FROM agent_runs.schema_migrations), (SELECT count(*) FROM agent_runs.schema_migrations),
       (SELECT count(*) FROM agent_runs.jobs), (SELECT count(*) FROM agent_runs.trials);
----
1	1	0	0

restart

query II
SELECT max(version), count(*) FROM agent_runs.schema_migrations;
----
1	1

statement ok
INSERT INTO agent_runs.schema_migrations VALUES (2);

restart no_extension_load

statement error
LOAD '{BUILD_DIRECTORY}/extension/agent_runs/agent_runs.duckdb_extension';
----
Catalog schema version 2 is newer than supported version 1

query I
SELECT max(version) FROM agent_runs.schema_migrations;
----
2

statement ok
DELETE FROM agent_runs.schema_migrations WHERE version = 2;

statement ok
LOAD '{BUILD_DIRECTORY}/extension/agent_runs/agent_runs.duckdb_extension';
