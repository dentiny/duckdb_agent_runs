# name: test/sql/ingest_validation.test
# description: Ingestion argument validation and preflight without side effects
# group: [sql]

require agent_runs

statement error
SELECT * FROM ingest_agent_run(NULL);
----
must not be NULL

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/artifacts');
----
job_destination is required

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/artifacts', format := 'unknown', job_destination := '{TEST_DIR}/invalid');
----
Unsupported run format

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/artifacts', job_destination := ' ');
----
nonblank

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/artifacts', job_destination := 'testdata/harbor/artifacts/inside');
----
must not overlap

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/artifacts', job_destination := 'testdata/harbor/artifacts/../artifacts/inside');
----
must not overlap

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/missing_result', job_destination := '{TEST_DIR}/invalid');
----
Harbor job requires result.json

query I
SELECT count(*) FROM glob('{TEST_DIR}/**/*');
----
0

statement ok
SET enable_external_access = false;

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/artifacts', job_destination := '{TEST_DIR}/disabled');
----
enable_external_access
