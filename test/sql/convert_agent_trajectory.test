# name: test/sql/convert_agent_trajectory.test
# description: Read back agent_runs output with the independent Lance test dependency
# group: [sql]

require agent_runs

foreach codec lz4 zstd none

query I
CALL convert_agent_trajectory('testdata/atif/multimodal/trajectory.json',
    trajectory_destination := '{TEST_DIR}/{codec}.lance', text_compression := '{codec}');
----
1

endloop

query I
CALL convert_agent_trajectory('testdata/atif/text/trajectory.json.gz',
    trajectory_destination := '{TEST_DIR}/gzip.lance');
----
1

query I
CALL convert_agent_trajectory('testdata/atif/text/trajectory.json',
    trajectory_destination := '{TEST_DIR}/quote''s.lance');
----
1

# The two extensions register the same COPY format. Verify the written datasets
# in a fresh database with only the independent Lance reader loaded.
restart no_extension_load

require lance

require json

foreach codec lz4 zstd none

query I
SELECT count(*) FROM '{TEST_DIR}/{codec}.lance';
----
1

# Compare stored metadata and the preserved document with the local ATIF fixture.
query IIIII
SELECT d.trajectory_id = json_extract_string(j, 'trajectory_id'), d.atif_schema_version = json_extract_string(j, 'schema_version'),
       d.agent.name = json_extract_string(j, '$.agent.name'), d.agent.version = json_extract_string(j, '$.agent.version'),
       d.raw_json = expected.content
FROM '{TEST_DIR}/{codec}.lance' d,
     (SELECT content, content::JSON j FROM read_text('testdata/atif/multimodal/trajectory.json')) expected;
----
true	true	true	true	true

# Read the typed step data, text and observations from Lance, including Unicode.
query IIIIII
SELECT list_transform(d.steps, lambda s: s.step_id) = [1, 2, 3],
       list_transform(d.steps, lambda s: s.source) = ['user', 'agent', 'agent'],
       decode(d.steps[1].message[1].text) = json_extract_string(j, '$.steps[0].message[0].text'),
       decode(d.steps[2].message[1].text) = json_extract_string(j, '$.steps[1].message'),
       decode(d.steps[2].observation.results[1].content[1].text) = json_extract_string(j, '$.steps[1].observation.results[0].content[0].text'),
       decode(d.steps[3].message[1].text) = json_extract_string(j, '$.steps[2].message')
FROM '{TEST_DIR}/{codec}.lance' d,
     (SELECT content::JSON j FROM read_text('testdata/atif/multimodal/trajectory.json')) expected;
----
true	true	true	true	true	true

query III
SELECT d.steps[2].tool_calls[1].tool_call_id = json_extract_string(j, '$.steps[1].tool_calls[0].tool_call_id'),
       d.steps[2].tool_calls[1].function_name = json_extract_string(j, '$.steps[1].tool_calls[0].function_name'),
       d.steps[2].tool_calls[1].arguments_json::JSON = json_extract(j, '$.steps[1].tool_calls[0].arguments')
FROM '{TEST_DIR}/{codec}.lance' d,
     (SELECT content::JSON j FROM read_text('testdata/atif/multimodal/trajectory.json')) expected;
----
true	true	true

# Compare embedded message/observation media bytes with the repository PNG/WAV files.
query IIII
SELECT d.steps[1].message[2].source.path = image.content,
       d.steps[1].message[3].source.path = audio.content,
       d.steps[2].observation.results[1].content[2].source.path = image.content,
       d.steps[2].observation.results[1].content[3].source.path = audio.content
FROM '{TEST_DIR}/{codec}.lance' d,
     read_blob('testdata/atif/multimodal/atif-image.png') image,
     read_blob('testdata/atif/multimodal/atif-audio.wav') audio;
----
true	true	true	true

endloop

foreach dataset gzip quote''s

query III
SELECT d.trajectory_id = json_extract_string(j, 'trajectory_id'), d.agent.name = json_extract_string(j, '$.agent.name'),
       decode(d.steps[1].message[1].text) = json_extract_string(j, '$.steps[0].message')
FROM '{TEST_DIR}/{dataset}.lance' d,
     (SELECT content::JSON j FROM read_text('testdata/atif/text/trajectory.json')) expected;
----
true	true	true

endloop
