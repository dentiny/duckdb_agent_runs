# name: test/sql/atif_lance_conversion.test
# description: Convert ATIF to Lance through the bundled conversion extension
# group: [sql]

require agent_runs

foreach codec lz4 zstd none

query I
COPY (SELECT * FROM read_atif('testdata/atif/multimodal/trajectory.json'))
TO '{TEST_DIR}/{codec}.lance' (FORMAT LANCE, STORAGE_VERSION '2.2', COLUMN_COMPRESSION {
    'steps.message.text': '{codec}', 'steps.observation.results.content.text': '{codec}'
});
----
1

query I
SELECT count(*) > 0 FROM glob('{TEST_DIR}/{codec}.lance/_versions/*.manifest');
----
true

# Both message and observation media are stored in the dataset itself.
query II
SELECT sum((length(hex(content)) - length(replace(hex(content),
           (SELECT hex(content) FROM read_blob('testdata/atif/multimodal/atif-image.png')), ''))) /
           (SELECT length(hex(content)) FROM read_blob('testdata/atif/multimodal/atif-image.png'))),
       sum((length(hex(content)) - length(replace(hex(content),
           (SELECT hex(content) FROM read_blob('testdata/atif/multimodal/atif-audio.wav')), ''))) /
           (SELECT length(hex(content)) FROM read_blob('testdata/atif/multimodal/atif-audio.wav')))
FROM read_blob('{TEST_DIR}/{codec}.lance/data/*.lance');
----
2	2

endloop

query I
COPY (SELECT * FROM read_atif('testdata/atif/text/trajectory.json.gz'))
TO '{TEST_DIR}/gzip.lance' (FORMAT LANCE, STORAGE_VERSION '2.2');
----
1
