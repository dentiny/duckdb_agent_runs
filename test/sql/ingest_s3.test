# name: test/sql/ingest_s3.test
# description: Ingest local and S3 Harbor jobs with embedded ATIF media
# group: [sql]

require-env AGENT_RUNS_S3_ENDPOINT

require-env AGENT_RUNS_S3_BUCKET

require-env AGENT_RUNS_S3_KEY_ID

require-env AGENT_RUNS_S3_SECRET

require agent_runs

require httpfs

# Use a fresh prefix on every run. The endpoint is a disposable local S3 service.
statement ok
SET VARIABLE s3_root = 's3://{AGENT_RUNS_S3_BUCKET}/agent-runs-' || uuid()::VARCHAR;

statement ok
CREATE SECRET agent_runs_test (TYPE S3, KEY_ID '{AGENT_RUNS_S3_KEY_ID}',
    SECRET '{AGENT_RUNS_S3_SECRET}', REGION 'us-east-1', ENDPOINT '{AGENT_RUNS_S3_ENDPOINT}',
    URL_STYLE 'path', USE_SSL false, SCOPE 's3://{AGENT_RUNS_S3_BUCKET}/');

query T
SELECT status FROM ingest_agent_run('testdata/harbor/multimodal', dry_run := true,
    job_destination := getvariable('s3_root') || '/job',
    trajectory_destination := getvariable('s3_root') || '/trajectories');
----
planned

query I
SELECT count(*) FROM glob(getvariable('s3_root') || '/**');
----
0

query T
SELECT status FROM ingest_agent_run('testdata/harbor/multimodal',
    job_destination := getvariable('s3_root') || '/job',
    trajectory_destination := getvariable('s3_root') || '/trajectories');
----
ingested

query II
SELECT count(*), bool_and(coalesce(source.content = target.content, false))
FROM read_blob('testdata/harbor/multimodal/**/*') source
FULL JOIN read_blob(getvariable('s3_root') || '/job/**/*') target
ON substring(target.filename, length(getvariable('s3_root') || '/job') + 1) =
   substring(source.filename, length('testdata/harbor/multimodal') + 1);
----
7	true

query I
SELECT count(*) > 0 FROM glob(getvariable('s3_root') || '/trajectories/task__abc.lance/_versions/*.manifest');
----
true

query II
SELECT sum((length(hex(content)) - length(replace(hex(content),
           (SELECT hex(content) FROM read_blob('testdata/atif/multimodal/atif-image.png')), ''))) /
           (SELECT length(hex(content)) FROM read_blob('testdata/atif/multimodal/atif-image.png'))),
       sum((length(hex(content)) - length(replace(hex(content),
           (SELECT hex(content) FROM read_blob('testdata/atif/multimodal/atif-audio.wav')), ''))) /
           (SELECT length(hex(content)) FROM read_blob('testdata/atif/multimodal/atif-audio.wav')))
FROM read_blob(getvariable('s3_root') || '/trajectories/task__abc.lance/data/*.lance');
----
2	2

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/multimodal',
    job_destination := getvariable('s3_root') || '/another-job',
    trajectory_destination := getvariable('s3_root') || '/trajectories');
----
already exists

query I
SELECT count(*) FROM glob(getvariable('s3_root') || '/another-job/**');
----
0

# A job prefix on S3 can be the source, including relative media references.
query T
SELECT status FROM ingest_agent_run(getvariable('s3_root') || '/job/', dry_run := true,
    job_destination := getvariable('s3_root') || '/remote-job',
    trajectory_destination := getvariable('s3_root') || '/remote-trajectories');
----
planned

query I
SELECT count(*) FROM glob(getvariable('s3_root') || '/remote-*/**');
----
0

query TI
SELECT status, file_count FROM ingest_agent_run(getvariable('s3_root') || '/job/',
    job_destination := getvariable('s3_root') || '/remote-job',
    trajectory_destination := getvariable('s3_root') || '/remote-trajectories');
----
ingested	7

query II
SELECT count(*), bool_and(coalesce(source.content = target.content, false))
FROM read_blob('testdata/harbor/multimodal/**/*') source
FULL JOIN read_blob(getvariable('s3_root') || '/remote-job/**/*') target
ON substring(target.filename, length(getvariable('s3_root') || '/remote-job') + 1) =
   substring(source.filename, length('testdata/harbor/multimodal') + 1);
----
7	true

query II
SELECT sum((length(hex(content)) - length(replace(hex(content),
           (SELECT hex(content) FROM read_blob('testdata/atif/multimodal/atif-image.png')), ''))) /
           (SELECT length(hex(content)) FROM read_blob('testdata/atif/multimodal/atif-image.png'))),
       sum((length(hex(content)) - length(replace(hex(content),
           (SELECT hex(content) FROM read_blob('testdata/atif/multimodal/atif-audio.wav')), ''))) /
           (SELECT length(hex(content)) FROM read_blob('testdata/atif/multimodal/atif-audio.wav')))
FROM read_blob(getvariable('s3_root') || '/remote-trajectories/task__abc.lance/data/*.lance');
----
2	2

# Remote sources can also write to local destinations.
query T
SELECT status FROM ingest_agent_run(getvariable('s3_root') || '/job',
    job_destination := '{TEST_DIR}/remote-job', trajectory_destination := '{TEST_DIR}/remote-trajectories');
----
ingested

query II
SELECT count(*), bool_and(coalesce(source.content = target.content, false))
FROM read_blob('testdata/harbor/multimodal/**/*') source
FULL JOIN read_blob('{TEST_DIR}/remote-job/**/*') target
ON substring(target.filename, length('{TEST_DIR}/remote-job') + 1) =
   substring(source.filename, length('testdata/harbor/multimodal') + 1);
----
7	true

statement error
SELECT * FROM ingest_agent_run(getvariable('s3_root') || '/job',
    job_destination := getvariable('s3_root') || '/job/nested',
    trajectory_destination := getvariable('s3_root') || '/overlapping-trajectories');
----
must not overlap

statement error
SELECT * FROM ingest_agent_run(getvariable('s3_root') || '/missing',
    job_destination := getvariable('s3_root') || '/missing-job');
----
Harbor job requires config.json

# Derive implicit trial/step directories from remote object keys.
query I
SELECT count(*) FROM ingest_agent_run('testdata/harbor/multistep',
    job_destination := getvariable('s3_root') || '/steps-job',
    trajectory_destination := getvariable('s3_root') || '/steps-trajectories');
----
2

query TT rowsort
SELECT status, regexp_extract(trajectory_destination, '(step-[12]\.lance)$', 1)
FROM ingest_agent_run(getvariable('s3_root') || '/steps-job',
    job_destination := '{TEST_DIR}/steps-job', trajectory_destination := '{TEST_DIR}/steps-trajectories');
----
ingested	step-1.lance
ingested	step-2.lance
