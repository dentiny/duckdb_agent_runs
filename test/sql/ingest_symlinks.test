# name: test/sql/ingest_symlinks.test
# description: Reject file symlinks and directory cycles before writing
# group: [sql]

require agent_runs

require notwindows

foreach fixture symlink symlink_loop

statement error
SELECT * FROM ingest_agent_run('testdata/harbor/{fixture}', job_destination := '{TEST_DIR}/{fixture}');
----
Symlinks are not supported

endloop

query I
SELECT count(*) FROM glob('{TEST_DIR}/**/*');
----
0
